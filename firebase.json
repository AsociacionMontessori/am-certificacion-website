{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/buscador",
        "destination": "/directorio",
        "type": 301
      },
      {
        "source": "/buscador/**",
        "destination": "/directorio",
        "type": 301
      },
      {
        "source": "/certificate",
        "destination": "/diplomados/#certificacion_internacional",
        "type": 301
      },
      {
        "source": "/certificate/**",
        "destination": "/diplomados/#certificacion_internacional",
        "type": 301
      },
      {
        "source": "/masterclasses",
        "destination": "/diplomados/",
        "type": 301
      },
      {
        "source": "/masterclasses/**",
        "destination": "/diplomados/",
        "type": 301
      },
      {
        "source": "/otroscursos",
        "destination": "/diplomados/",
        "type": 301
      },
      {
        "source": "/otroscursos/**",
        "destination": "/diplomados/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|eot|otf|ttf|ttc|woff|woff2|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
