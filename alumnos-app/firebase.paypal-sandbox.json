{
  "functions": [
    {
      "source": "functions-paypal-sandbox",
      "codebase": "paypal-sandbox",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*"
      ]
    }
  ],
  "hosting": {
    "site": "certimontessori-sandbox",
    "public": "hosting-paypal-sandbox",
    "redirects": [{"source": "/", "destination": "/checkout/paypal-sandbox/", "type": 302}],
    "ignore": [
      "firebase*.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
