{
  "name": "am website",
  "private": true,
  "description": "Montessori Asociation web site",
  "version": "0.1.0",
  "author": "Asociación Montessori de México A.C.",
  "dependencies": {
    "@headlessui/react": "^1.7.15",
    "@heroicons/react": "^2.0.18",
    "@noble/hashes": "^1.8.0",
    "axios": "^1.4.0",
    "d3-fetch": "^3.0.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-responsive-iframe": "^6.11.1",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "he": "^1.2.0",
    "i18next": "^26.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-i18next": "^17.0.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "cheerio": "1.0.0-rc.12",
    "daisyui": "^3.2.1",
    "firebase-tools": "^15.18.0",
    "gatsby-plugin-postcss": "^6.16.0",
    "patch-package": "^8.0.1",
    "path-to-regexp": "0.1.13",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "sax": "^1.6.0",
    "sitemap": "^7.1.3",
    "tailwindcss": "^3.3.2"
  },
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "postinstall": "patch-package",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1",
    "test:analytics": "node scripts/test-analytics.js",
    "test:analytics-instrumentation": "node scripts/test-analytics-instrumentation.js",
    "test:seo-redirects": "node scripts/test-seo-redirects.js",
    "test:seo-sitemap": "node scripts/test-sitemap-seo.js",
    "test:seo-hosting": "node scripts/test-seo-hosting.js",
    "test:seo-built": "node scripts/test-seo-built.js",
    "test:hosting-http": "firebase emulators:exec --only hosting --project certificacionmontessori \"node scripts/test-hosting-http.js\"",
    "test:deployed-hosting": "node scripts/test-deployed-hosting.js",
    "indexnow:init": "node scripts/init-indexnow-key.js",
    "indexnow:submit": "node scripts/submit-indexnow.js",
    "test:indexnow": "node scripts/test-indexnow.js",
    "deploy": "npm run test:foundation && npm run build && npm run test:seo-built && npx firebase deploy --only hosting",
    "deploy:preview": "npm run test:foundation && npm run build && npm run test:seo-built && npx firebase hosting:channel:deploy preview",
    "firebase:init": "npx firebase init hosting",
    "firebase:login": "npx firebase login",
    "firebase:use": "npx firebase use certificacionmontessori",
    "test:analytics-consent": "node scripts/test-analytics-consent.js",
    "test:wordpress-analytics": "node scripts/test-wordpress-analytics-snippet.js",
    "test:wordpress-posts": "node scripts/test-wordpress-posts.js",
    "test:wordpress-source": "node scripts/test-wordpress-source.js",
    "test:publications-built": "node scripts/test-publications-built.js",
    "refresh:wordpress-posts": "node scripts/refresh-wordpress-posts.js",
    "test:foundation": "npm run test:analytics && npm run test:wordpress-analytics && npm run test:analytics-consent && npm run test:analytics-instrumentation && npm run test:indexnow && npm run test:seo-redirects && npm run test:seo-sitemap && npm run test:seo-hosting"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AsociacionMontessori/am-website.git"
  },
  "overrides": {
    "path-to-regexp": "$path-to-regexp",
    "superstatic": {
      "path-to-regexp": "1.9.0"
    },
    "router": {
      "path-to-regexp": "8.4.2"
    },
    "file-type": "22.0.1",
    "cookie": "0.7.2",
    "immutable": "3.8.3",
    "lodash": "4.18.1",
    "serialize-javascript": "7.0.5",
    "tmp": "0.2.7",
    "webpack": "5.107.1",
    "uuid": "11.1.1",
    "@parcel/cache": "2.16.4",
    "@parcel/core": "2.16.4",
    "@parcel/bundler-default": "2.16.4",
    "@parcel/compressor-raw": "2.16.4",
    "@parcel/namer-default": "2.16.4",
    "@parcel/optimizer-terser": "2.16.4",
    "@parcel/packager-js": "2.16.4",
    "@parcel/packager-raw": "2.16.4",
    "@parcel/reporter-dev-server": "2.16.4",
    "@parcel/resolver-default": "2.16.4",
    "@parcel/runtime-js": "2.16.4",
    "@parcel/transformer-js": "2.16.4",
    "@parcel/transformer-json": "2.16.4",
    "@parcel/fs": "2.16.4",
    "@parcel/package-manager": "2.16.4",
    "@parcel/plugin": "2.16.4",
    "@parcel/types": "2.16.4",
    "@parcel/utils": "2.16.4",
    "@parcel/workers": "2.16.4"
  }
}
